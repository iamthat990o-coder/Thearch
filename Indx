import express from "express";
import cors from "cors";
import dotenv from "dotenv";
import Anthropic from "@anthropic-ai/sdk";

dotenv.config();

const app = express();
app.use(cors());
app.use(express.json({ limit: "2mb" }));

const anthropic = new Anthropic({ apiKey: process.env.ANTHROPIC_API_KEY });
const MODEL = "claude-sonnet-4-6";

// وظائف تجريبية — استبدلها بقاعدة بيانات / مصادر رسمية
const JOBS = [
  { id: 1, title: "محلل مالي", company: "شركة اتصالات كبرى", city: "الرياض", type: "قطاع خاص",
    desc: "إعداد الموازنات والتقارير المالية وفق معايير IFRS، تحليل الأداء المالي، استخدام SAP، بناء نماذج مالية، متابعة التدفقات النقدية." },
  { id: 2, title: "مهندس برمجيات (Backend)", company: "شركة ناشئة تقنية", city: "جدة", type: "شركات ناشئة",
    desc: "تطوير خدمات backend باستخدام Node.js أو Python، تصميم قواعد بيانات، بناء REST APIs، العمل مع السحابة AWS، خبرة في Git." },
  { id: 3, title: "أخصائي تسويق رقمي", company: "مجموعة تجزئة", city: "الرياض", type: "قطاع خاص",
    desc: "إدارة حملات إعلانية على المنصات، تحليل البيانات، SEO، إدارة محتوى السوشيال ميديا، متابعة مؤشرات الأداء ROI." },
  { id: 4, title: "مدير مشاريع", company: "جهة شبه حكومية", city: "الدمام", type: "شبه حكومي",
    desc: "إدارة دورة حياة المشاريع، منهجيات Agile وPMP، إدارة الميزانيات وأصحاب المصلحة، تقارير التقدم، إدارة المخاطر." },
  { id: 5, title: "محلل بيانات", company: "بنك محلي", city: "الرياض", type: "قطاع خاص",
    desc: "تحليل البيانات باستخدام SQL وPython، بناء لوحات معلومات Power BI، نمذجة إحصائية، استخلاص رؤى للأعمال." },
];

app.get("/api/jobs", (req, res) => res.json(JOBS));

// تحليل السيرة + المطابقة
app.post("/api/analyze", async (req, res) => {
  const { resumeText } = req.body || {};
  if (!resumeText?.trim()) return res.status(400).json({ error: "resumeText مطلوب" });

  const jobsForPrompt = JOBS.map(
    (j) => `#${j.id} — ${j.title} | ${j.company} | ${j.city} | ${j.type}\n${j.desc}`
  ).join("\n\n");

  const prompt = `أنت محرّك مطابقة وظائف. حلّل السيرة الذاتية وطابقها مع الوظائف.

السيرة الذاتية:
"""${resumeText.slice(0, 6000)}"""

الوظائف:
"""${jobsForPrompt}"""

أعِد فقط JSON صالح بدون markdown:
{
 "profile": {"title":"...","years":"...","skills":["..."],"summary":"..."},
 "matches":[{"id":رقم,"score":0-100,"reason":"سبب بجملة","gaps":"النواقص بجملة"}]
}
رتّب matches تنازليًا حسب score. بالعربية.`;

  try {
    const msg = await anthropic.messages.create({
      model: MODEL,
      max_tokens: 1200,
      messages: [{ role: "user", content: prompt }],
    });
    const raw = msg.content.filter((b) => b.type === "text").map((b) => b.text).join("").replace(/```json|```/g, "").trim();
    const parsed = JSON.parse(raw);
    const matches = parsed.matches
      .map((m) => ({ ...m, job: JOBS.find((j) => j.id === m.id) }))
      .filter((m) => m.job);
    res.json({ profile: parsed.profile, matches });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "تعذّر التحليل" });
  }
});

// صياغة سيرة مخصصة لوظيفة
app.post("/api/rewrite", async (req, res) => {
  const { resumeText, jobId } = req.body || {};
  const job = JOBS.find((j) => j.id === Number(jobId));
  if (!resumeText?.trim() || !job) return res.status(400).json({ error: "بيانات ناقصة" });

  const prompt = `أعد صياغة السيرة الذاتية لتناسب هذه الوظيفة تحديدًا، مع إبراز الكلمات المفتاحية لتجاوز أنظمة ATS. سيرة مختصرة واحترافية بالعربية (ملخص مهني + أبرز المهارات + أبرز الخبرات). لا تخترع خبرات غير موجودة.

الوظيفة: ${job.title} — ${job.desc}

السيرة الأصلية:
"""${resumeText.slice(0, 4000)}"""`;

  try {
    const msg = await anthropic.messages.create({
      model: MODEL,
      max_tokens: 1200,
      messages: [{ role: "user", content: prompt }],
    });
    const text = msg.content.filter((b) => b.type === "text").map((b) => b.text).join("").trim();
    res.json({ text });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "تعذّرت الصياغة" });
  }
});

const PORT = process.env.PORT || 8787;
app.listen(PORT, () => console.log(`✅ Server on http://localhost:${PORT}`));
