import React, { useState, useRef, useCallback } from "react";
import mammoth from "mammoth";
import { Upload, FileText, Loader2, Target, Sparkles, X, PenLine, Check, Copy } from "lucide-react";

const NAVY = "#16264D";
const NAVY_2 = "#28407A";

async function extractPdfText(file) {
  const buf = await file.arrayBuffer();
  const pdf = await window.pdfjsLib.getDocument({ data: buf }).promise;
  let text = "";
  for (let i = 1; i <= pdf.numPages; i++) {
    const page = await pdf.getPage(i);
    const content = await page.getTextContent();
    text += content.items.map((it) => it.str).join(" ") + "\n";
  }
  return text;
}

async function extractDocxText(file) {
  const buf = await file.arrayBuffer();
  const res = await mammoth.extractRawText({ arrayBuffer: buf });
  return res.value;
}

export default function App() {
  const [resumeText, setResumeText] = useState("");
  const [fileName, setFileName] = useState("");
  const [parsing, setParsing] = useState(false);
  const [analyzing, setAnalyzing] = useState(false);
  const [profile, setProfile] = useState(null);
  const [matches, setMatches] = useState(null);
  const [error, setError] = useState("");
  const [drag, setDrag] = useState(false);
  const [rewriteFor, setRewriteFor] = useState(null);
  const [rewrites, setRewrites] = useState({});
  const [copied, setCopied] = useState(null);
  const inputRef = useRef(null);

  const handleFile = useCallback(async (file) => {
    if (!file) return;
    setError(""); setParsing(true); setFileName(file.name);
    try {
      let text = ""; const name = file.name.toLowerCase();
      if (name.endsWith(".pdf")) text = await extractPdfText(file);
      else if (name.endsWith(".docx")) text = await extractDocxText(file);
      else if (name.endsWith(".txt")) text = await file.text();
      else throw new Error("الصيغة غير مدعومة. استخدم PDF أو DOCX أو TXT.");
      if (!text.trim()) throw new Error("ما قدرنا نقرأ نص من الملف. جرّب لصق النص يدويًا.");
      setResumeText(text.trim());
    } catch (e) {
      setError(e.message || "صار خطأ أثناء قراءة الملف."); setFileName("");
    } finally { setParsing(false); }
  }, []);

  const analyze = async () => {
    if (!resumeText.trim()) { setError("ارفع سيرتك الذاتية أو الصق نصها أولًا."); return; }
    setError(""); setAnalyzing(true); setProfile(null); setMatches(null); setRewrites({});
    try {
      const res = await fetch("/api/analyze", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ resumeText }),
      });
      if (!res.ok) throw new Error();
      const data = await res.json();
      setProfile(data.profile);
      setMatches(data.matches);
    } catch (e) { setError("ما قدرنا نحلل السيرة. تأكد أن السيرفر شغّال."); }
    finally { setAnalyzing(false); }
  };

  const rewriteResume = async (job) => {
    setRewriteFor(job.id); setError("");
    try {
      const res = await fetch("/api/rewrite", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ resumeText, jobId: job.id }),
      });
      if (!res.ok) throw new Error();
      const data = await res.json();
      setRewrites((r) => ({ ...r, [job.id]: data.text }));
    } catch (e) { setError("تعذّر إنشاء الصياغة. جرّب مرة ثانية."); }
    finally { setRewriteFor(null); }
  };

  const copyText = (id, text) => {
    navigator.clipboard?.writeText(text);
    setCopied(id); setTimeout(() => setCopied(null), 1500);
  };

  const reset = () => { setResumeText(""); setFileName(""); setProfile(null); setMatches(null); setError(""); setRewrites({}); };
  const scoreColor = (s) => (s >= 80 ? "#16264D" : s >= 60 ? "#5A6B8C" : "#9AA3B5");

  return (
    <div dir="rtl" className="min-h-screen bg-white text-slate-800">
      <header style={{ background: NAVY }}>
        <div className="max-w-3xl mx-auto px-5 py-4 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 rounded-lg flex items-center justify-center bg-white">
              <Target className="w-5 h-5" style={{ color: NAVY }} />
            </div>
            <span className="font-extrabold text-lg text-white">محرّك المطابقة</span>
          </div>
          <span className="text-xs text-blue-200">نسخة أولية · MVP</span>
        </div>
      </header>

      <main className="max-w-3xl mx-auto px-5 py-8">
        <h1 className="text-2xl font-extrabold mb-1 leading-tight" style={{ color: NAVY }}>
          ارفع السيرة الذاتية، ونطابقها ونصيغها بالذكاء الاصطناعي
        </h1>
        <p className="text-slate-500 mb-6 text-sm">
          قراءة السيرة ← استخراج المؤهلات ← نسبة التوافق ← صياغة سيرة مخصصة لكل وظيفة.
        </p>

        {!resumeText ? (
          <div
            onDragOver={(e) => { e.preventDefault(); setDrag(true); }}
            onDragLeave={() => setDrag(false)}
            onDrop={(e) => { e.preventDefault(); setDrag(false); handleFile(e.dataTransfer.files[0]); }}
            onClick={() => inputRef.current?.click()}
            className="rounded-2xl border-2 border-dashed p-10 text-center cursor-pointer transition hover:bg-slate-50"
            style={{ borderColor: drag ? NAVY : "#C7CEDB", background: drag ? "#EEF3FB" : "#fff" }}
          >
            <input ref={inputRef} type="file" accept=".pdf,.docx,.txt" className="hidden" onChange={(e) => handleFile(e.target.files[0])} />
            {parsing ? (
              <div className="flex flex-col items-center gap-2 text-slate-500">
                <Loader2 className="w-7 h-7 animate-spin" /><span>نقرأ الملف…</span>
              </div>
            ) : (
              <div className="flex flex-col items-center gap-2">
                <Upload className="w-8 h-8" style={{ color: NAVY_2 }} />
                <span className="font-bold" style={{ color: NAVY }}>اسحب السيرة هنا أو اضغط للرفع</span>
                <span className="text-xs text-slate-400">PDF أو DOCX أو TXT</span>
              </div>
            )}
          </div>
        ) : (
          <div className="rounded-2xl border p-4 flex items-center justify-between" style={{ borderColor: "#E2E6EF" }}>
            <div className="flex items-center gap-3">
              <FileText className="w-5 h-5" style={{ color: NAVY }} />
              <div>
                <div className="font-bold text-sm" style={{ color: NAVY }}>{fileName || "نص السيرة الذاتية"}</div>
                <div className="text-xs text-slate-400">{resumeText.length} حرف تم استخراجه</div>
              </div>
            </div>
            <button onClick={reset} className="text-slate-400 hover:text-slate-600 p-1"><X className="w-5 h-5" /></button>
          </div>
        )}

        {!resumeText && (
          <textarea value={resumeText} onChange={(e) => setResumeText(e.target.value)}
            placeholder="أو الصق نص سيرتك الذاتية هنا مباشرة…"
            className="mt-4 w-full h-28 rounded-xl border p-3 text-sm bg-white focus:outline-none focus:ring-2 resize-none"
            style={{ borderColor: "#D7DCE7" }} />
        )}

        {error && <div className="mt-4 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">{error}</div>}

        <button onClick={analyze} disabled={analyzing || !resumeText.trim()}
          className="mt-5 w-full rounded-xl py-3.5 font-bold text-white flex items-center justify-center gap-2 disabled:opacity-40 transition"
          style={{ background: NAVY }}>
          {analyzing ? (<><Loader2 className="w-5 h-5 animate-spin" /> نحلّل ونطابق…</>) : (<><Sparkles className="w-5 h-5" /> حلّل وطابق الوظائف</>)}
        </button>

        {profile && (
          <section className="mt-8 rounded-2xl border p-5" style={{ borderColor: "#E2E6EF" }}>
            <h2 className="font-extrabold mb-3 flex items-center gap-2" style={{ color: NAVY }}>
              <span className="w-1.5 h-5 rounded-full" style={{ background: NAVY }} /> الملف المستخرج
            </h2>
            <div className="text-sm space-y-2">
              <p><span className="text-slate-400">المسمى:</span> <span className="font-bold" style={{ color: NAVY }}>{profile.title}</span></p>
              <p><span className="text-slate-400">الخبرة:</span> {profile.years}</p>
              <p className="text-slate-600">{profile.summary}</p>
              <div className="flex flex-wrap gap-2 pt-1">
                {profile.skills?.map((s, i) => (
                  <span key={i} className="text-xs rounded-full px-3 py-1" style={{ background: "#EEF1F7", color: NAVY }}>{s}</span>
                ))}
              </div>
            </div>
          </section>
        )}

        {matches && (
          <section className="mt-6 space-y-3">
            <h2 className="font-extrabold flex items-center gap-2" style={{ color: NAVY }}>
              <span className="w-1.5 h-5 rounded-full" style={{ background: NAVY }} /> الوظائف المطابقة ({matches.length})
            </h2>
            {matches.map((m) => (
              <div key={m.id} className="rounded-2xl border p-4" style={{ borderColor: "#E2E6EF" }}>
                <div className="flex items-start justify-between gap-3">
                  <div className="flex-1">
                    <div className="font-bold" style={{ color: NAVY }}>{m.job.title}</div>
                    <div className="text-xs text-slate-400 mt-0.5">{m.job.company} · {m.job.city} · {m.job.type}</div>
                  </div>
                  <div className="text-center shrink-0">
                    <div className="text-2xl font-extrabold" style={{ color: scoreColor(m.score) }}>{m.score}%</div>
                    <div className="text-[10px] text-slate-400">توافق</div>
                  </div>
                </div>
                <div className="mt-2 h-1.5 rounded-full overflow-hidden" style={{ background: "#EEF1F7" }}>
                  <div className="h-full rounded-full transition-all" style={{ width: `${m.score}%`, background: scoreColor(m.score) }} />
                </div>
                <p className="text-sm text-slate-600 mt-3">{m.reason}</p>
                {m.gaps && <p className="text-xs text-slate-500 mt-1">⚠ {m.gaps}</p>}

                {!rewrites[m.id] ? (
                  <button onClick={() => rewriteResume(m.job)} disabled={rewriteFor === m.id}
                    className="mt-3 text-sm font-bold rounded-lg px-3 py-2 flex items-center gap-2 disabled:opacity-50 transition"
                    style={{ background: "#EEF1F7", color: NAVY }}>
                    {rewriteFor === m.id ? (<><Loader2 className="w-4 h-4 animate-spin" /> نصيغ سيرة مخصصة…</>) : (<><PenLine className="w-4 h-4" /> صِغ سيرة مخصصة لهذه الوظيفة</>)}
                  </button>
                ) : (
                  <div className="mt-3 rounded-xl border p-3" style={{ borderColor: "#D7DCE7", background: "#FAFBFD" }}>
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-xs font-bold" style={{ color: NAVY }}>سيرة مخصصة لهذه الوظيفة</span>
                      <button onClick={() => copyText(m.id, rewrites[m.id])} className="text-xs flex items-center gap-1" style={{ color: NAVY_2 }}>
                        {copied === m.id ? (<><Check className="w-3.5 h-3.5" /> تم النسخ</>) : (<><Copy className="w-3.5 h-3.5" /> نسخ</>)}
                      </button>
                    </div>
                    <pre className="text-xs text-slate-700 whitespace-pre-wrap leading-relaxed" style={{ fontFamily: "'Tajawal', sans-serif" }}>{rewrites[m.id]}</pre>
                  </div>
                )}
              </div>
            ))}
          </section>
        )}
      </main>

      <footer className="mt-6" style={{ background: NAVY }}>
        <div className="max-w-3xl mx-auto px-5 py-6 text-center">
          <p className="text-white font-extrabold text-lg">بالتوفيق</p>
          <p className="text-blue-200 text-sm mt-1">الرياض · السعودية</p>
        </div>
      </footer>
    </div>
  );
}
